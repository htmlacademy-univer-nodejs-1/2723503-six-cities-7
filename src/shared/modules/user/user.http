@baseUrl = http://localhost:4000
# Токен из ответа POST /users/login
@token = <token>

## Загрузка аватара пользователя
POST {{baseUrl}}/users/avatar HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----SixCitiesFormBoundary

------SixCitiesFormBoundary
Content-Disposition: form-data; name="avatar"; filename="avatar-max.jpg"
Content-Type: image/jpeg

< ../../../../markup/img/avatar-max.jpg
------SixCitiesFormBoundary--
