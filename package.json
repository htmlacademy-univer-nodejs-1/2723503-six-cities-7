{
  "name": "six-cities",
  "version": "4.0.0",
  "description": "Проект «Шесть городов» от HTML Academy",
  "keywords": [
    "rest",
    "api",
    "node.js"
  ],
  "main": "main.js",
  "scripts": {
    "start": "npm run build && node ./dist/main.rest.js",
    "start:dev": "node --no-warnings --loader ts-node/esm ./src/main.rest.ts | pino-pretty",
    "build": "npm run clean && npm run compile",
    "lint": "eslint src/ --ext .ts",
    "compile": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "ts": "ts-node",
    "cli": "node --no-warnings --loader ts-node/esm ./src/main.cli.ts",
    "mock:server": "json-server --watch ./mocks/mock-server-data.json --port 3123"
  },
  "devDependencies": {
    "@types/convict": "6.1.6",
    "@types/convict-format-with-validator": "6.0.5",
    "@types/express": "4.17.21",
    "@types/mime-types": "2.1.4",
    "@types/multer": "1.4.12",
    "@types/node": "18.16.3",
    "@typescript-eslint/eslint-plugin": "5.46.0",
    "@typescript-eslint/parser": "5.46.0",
    "eslint": "8.39.0",
    "eslint-config-htmlacademy": "9.1.1",
    "json-server": "0.17.4",
    "pino-pretty": "13.0.0",
    "rimraf": "3.0.2",
    "ts-node": "10.9.1",
    "typescript": "4.9.5"
  },
  "type": "module",
  "engines": {
    "node": "^18.0.0",
    "npm": ">=8"
  },
  "dependencies": {
    "@typegoose/typegoose": "11.7.1",
    "axios": "1.7.9",
    "chalk": "5.3.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "convict": "6.2.4",
    "convict-format-with-validator": "6.2.0",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-async-handler": "1.2.0",
    "http-status-codes": "2.3.0",
    "inversify": "6.0.2",
    "jose": "5.9.6",
    "mime-types": "2.1.35",
    "mongoose": "7.6.3",
    "multer": "2.0.2",
    "nanoid": "5.0.9",
    "pino": "9.5.0",
    "reflect-metadata": "0.2.2"
  }
}
